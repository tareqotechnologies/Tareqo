<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de extração de dados (Android 12+): o app armazena dados
  financeiros (vendas, caixa, fiado) — NADA é incluído em backups na nuvem
  nem em transferência de dispositivo. Complementa android:allowBackup=false
  (auditoria S6).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
