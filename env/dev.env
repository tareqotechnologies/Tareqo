SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvdGtsYnBxbWxuaGNkaWZpdWtkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU1ODk2NTcsImV4cCI6MjEwMTE2NTY1N30.ssUUe7G2U5LDKP1-b8FO8ngTwq6_RODxE58NuGw2Zfs

# A1: marcador de credenciais EXPLÍCITAS (a guarda de release rejeita
