# Ambiente de PRODUÇÃO — NUNCA versionar o ficheiro real (env/prod.env está
# no .gitignore). Copie este modelo, preencha com os valores do projeto de
# PRODUÇÃO e guarde o ficheiro fora do repositório (ou nos secrets do CI).
#
# Uso local:
#   flutter build appbundle --flavor prod \
#     --dart-define-from-file=env/prod.env --release
#
# No CI, os mesmos valores vêm dos secrets do workflow release.yml
# (SUPABASE_URL_PROD / SUPABASE_ANON_KEY_PROD) e são passados diretamente
# como --dart-define pelo Fastlane — não precisa deste ficheiro.
# ⚠️ NÃO defina FLUTTER_APP_FLAVOR aqui: é um define reservado do framework,
# injetado automaticamente a partir do --flavor (lido por AppFlavorConfig).
#
# ⚠️ Dev e prod são projetos SEPARADOS (migração Set/2026): GoTrue (usuários)
# e banco independentes — credenciais de um NÃO funcionam no outro. Rode a
# rotação de senha (tool/rotate_owner_password.py --project dev|prod) em
# AMBOS quando uma credencial vazar. O env/prod.env real documenta o id do
# projeto de produção.
SUPABASE_URL=https://SEU-PROJETO-PROD.supabase.co
SUPABASE_ANON_KEY=eyJ...SUBSTITUIR_PELA_ANON_KEY_DE_PRODUCAO
# A1: a guarda de release rejeita releases com credenciais EMBUTIDAS.
# Este marcador declara que as credenciais acima são EXPLÍCITAS (necessário
# mesmo que os valores coincidam com os defaults — o Dart não distingue por
# valor). OBRIGATÓRIO em qualquer build de release.
SUPABASE_CREDENTIALS_EXPLICIT=true
# Opcional — ativa o Sentry em produção:
SENTRY_DSN=
# WhatsApp do suporte (ecrã Ajuda → "Fale com o suporte") — apenas dígitos
# com código do país. O default embutido em SupportConfig já é o número
# real; defina aqui apenas para apontar a outro número.
SUPPORT_WHATSAPP_NUMBER=
