# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Artefatos de release prontos para upload (APK/EXE/IPA) — vão para a
# GitHub Release, nunca para o repositório.
/release/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Assinatura de release (keystore de produção) — nunca versionar
android/key.properties
*.jks

# Backups de banco de producao (contem dados reais - nunca commitar)
backup_*.sql
*.keystore

# Ambiente de produção — nunca versionar (o exemplo em env/*.example é o modelo)
env/prod.env
env/db.env
# Credenciais de contas de TESTE (owner/manager/employee) para os E2E live.
# Nunca versionar: a senha do dono foi rotacionada (Sep 2026) após exposição
# em chat; o novo valor vive apenas aqui, localmente.
env/test_accounts.env
# QR SVG de matrícula de MFA (contém o secret TOTP como imagem) — nunca versionar
env/mfa_qr_*.svg
# Visual Studio (pasta .vs/ local do Windows)
windows/.vs/

# Fastlane — credenciais locais da service account
fastlane/play-service-account.json

# Artefato local da ferramenta de design (canvas de referência) — nunca versionar
.kombai/

# Base64 do keystore de upload (conveniência para adicionar o secret KEYSTORE_BASE64)
android/app/upload-keystore.jks.b64

# B3 (auditoria): artefatos locais fora do repositorio
*.log
compras_v.png
screenshot_session_check.png
*.iml
