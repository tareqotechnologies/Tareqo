# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Assinatura de release (keystore de produção) — nunca versionar
android/key.properties
*.jks

# Backups de banco de producao (contem dados reais - nunca commitar)
backup_*.sql
*.keystore

# Ambiente de produção — nunca versionar (o exemplo em env/*.example é o modelo)
env/prod.env

# Fastlane — credenciais locais da service account
fastlane/play-service-account.json

# Base64 do keystore de upload (conveniência para adicionar o secret KEYSTORE_BASE64)
android/app/upload-keystore.jks.b64
